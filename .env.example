# Optional Cloud Persistence (Zero-Config by default using LocalStorage)
# Choose either Firebase Realtime Database or Neon.tech Serverless PostgreSQL if cloud sync is desired.

# Option 1: Firebase Realtime Database REST URL (e.g. https://your-project-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=

# Option 2: Neon.tech Serverless PostgreSQL HTTP SQL API or Connection String
DATABASE_URL=
NEON_SQL_ENDPOINT=
